# BhashaTalk AI Server Environment Configuration
PORT=5000
NODE_ENV=production

# Optional: Google Gemini API Key for cloud LLM reasoning
# If omitted or offline, BhashaTalk AI seamlessly uses its high-accuracy
# built-in multilingual conversational intelligence engine.
GEMINI_API_KEY=

# Optional: Alternative LLM keys
OPENAI_API_KEY=

# Default operational mode: false = REAL AI MODE, true = DEMO / BENCHMARK MODE
MOCK_MODE=false
